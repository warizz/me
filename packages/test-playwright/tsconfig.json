{
  "$schema": "https://json.schemastore.org/tsconfig",
  "include": ["."],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "composite": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "skipLibCheck": true,
    "strict": true,
    "types": ["node"]
  }
}
